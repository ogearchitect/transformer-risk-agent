OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
# Azure AI Foundry (preferred — set these instead of OPENAI_API_KEY for Foundry)
# AZURE_OPENAI_API_KEY is OPTIONAL. Omit it to use Managed Identity / az login
# (DefaultAzureCredential) — recommended for production. Foundry accounts with
# kind=AIServices have disableLocalAuth=true and require Entra ID auth.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
LLM_PROVIDER=openai
LOG_LEVEL=INFO
